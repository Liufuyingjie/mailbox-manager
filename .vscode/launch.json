{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 邮箱管家（桌面窗口）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "运行 打包脚本（生成 exe）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_exe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
