{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "打包成 exe",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/build_exe.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "在浏览器中打开页面（调试界面）",
      "type": "shell",
      "command": "explorer",
      "args": ["${workspaceFolder}\\邮箱管家.html"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
